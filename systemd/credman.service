[Unit]
Description=credman — credential manager daemon
Documentation=man:credman(1)
After=local-fs.target
Before=network.target

# Rate-limit restarts. These keys belong in [Unit], not [Service].
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root

# Create /run/credman (0755 root:root) before the process starts.
# Without this, ReadWritePaths below would fail at namespace-setup
# time because the path doesn't yet exist.
RuntimeDirectory=credman
RuntimeDirectoryMode=0755

ExecStart=/usr/local/sbin/credman-daemon

# Neutral identifier — never expose internal tool names in the
# service description or the journal tag.
SyslogIdentifier=credman-daemon

# Restart on failure — credentials must always be available.
Restart=on-failure
RestartSec=2

# ── Hardening ────────────────────────────────────────────────────
# NoNewPrivileges must stay off: the credential backend needs the
# privilege to derive host-bound keys.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
# The credential backend persists a host-derived key under
# /var/lib/systemd/ on first use; without it in ReadWritePaths,
# ProtectSystem=strict rejects the write and `set` fails with
# "Read-only file system" until the key is manually seeded.
ReadWritePaths=/run/credman /etc/credstore.encrypted /var/lib/systemd
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
