# kepr direnv integration helper (.envrc)
#
# Usage in your project's .envrc:
#   source_env completions/kepr.envrc
#   use_kepr OPENAI_API_KEY ANTHROPIC_API_KEY DB_PASS
#
use_kepr() {
  if [ $# -eq 0 ]; then
    eval "$(kepr env)"
  else
    local csv
    csv=$(IFS=,; echo "$*")
    eval "$(kepr env --env "$csv")"
  fi
}
