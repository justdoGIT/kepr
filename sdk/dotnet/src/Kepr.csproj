    <RootNamespace>Kepr</RootNamespace>
    <AssemblyName>Kepr</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
