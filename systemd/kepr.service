[Unit]
Description=kepr — credential manager daemon
Documentation=man:kepr(1)
After=local-fs.target
Before=network.target

# Rate-limit restarts. These keys belong in [Unit], not [Service].
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
# Bind the master key to this machine's TPM2 (sealed via systemd-creds;
# P4.3). Values: host (default), tpm2, host+tpm2, auto. PCR binding makes
# a modified boot chain unable to unseal it. Applies to newly created
# master keys; existing ones keep their sealing.
#Environment=KEPR_MASTER_KEY_SEAL=host+tpm2
#Environment=KEPR_TPM2_PCRS=7
Type=simple
User=root
Group=root

# Create /run/kepr (0755 root:root) before the process starts.
# Without this, ReadWritePaths below would fail at namespace-setup
# time because the path doesn't yet exist.
RuntimeDirectory=kepr
RuntimeDirectoryMode=0755

# Create /var/lib/kepr (0700 root:root) before the process starts.
# This is where the in-process AEAD master key (master.key, sealed via
# systemd-creds) is persisted. The 0700 mode keeps the directory
# inaccessible to anyone but the daemon's owning uid (root).
StateDirectory=kepr
StateDirectoryMode=0700

ExecStart=/usr/local/bin/kepr-daemon
# Re-read /etc/kepr/policy.toml (T6.11) without a restart.
ExecReload=/bin/kill -HUP $MAINPID

# Neutral identifier — never expose internal tool names in the
# service description or the journal tag.
SyslogIdentifier=kepr-daemon

# Restart on failure — credentials must always be available.
Restart=on-failure
RestartSec=2

# ── Hardening ────────────────────────────────────────────────────
# Phase 0 α3 flipped this to yes: the credential backend now lives
# in-process (AES-256-GCM via aes-gcm crate). systemd-creds is only
# invoked once at startup to seal/unseal the master key, and that
# call does not need to gain new privileges via setuid binaries —
# it just runs as root the same way the daemon does.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# /var/lib/systemd is needed for systemd-creds' host-key state file;
# /var/lib/kepr is for the daemon's own master.key (created by the
# StateDirectory= directive above); /etc/credstore.encrypted is
# where credentials are written.
ReadWritePaths=/run/kepr /etc/credstore.encrypted /var/lib/systemd /var/lib/kepr
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Phase 0 finishing pass: drop the remaining `systemd-analyze security`
# exposure categories that don't require an architectural change. These
# bring the offline score from 3.0 down to the ≤ 2.5 target documented in
# the Phase 0 success criteria. Pinned by tests/systemd_unit.rs so a
# future edit that drops one of these directives fails CI.

# Daemon listens only on /run/kepr/kepr.sock and writes to the local
# journal — it has no IP path. The systemd-creds child invoked once at
# startup is also network-free (host-key derivation is local).
PrivateNetwork=yes

# No /dev/* access. Implies a private /dev mount with a closed device
# policy — strictly stronger than DeviceAllow= alone.
PrivateDevices=yes

# Daemon does not adjust the system clock, kernel log, or hostname.
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes

# /proc visibility tightening. `invisible` hides other processes' PID
# subtrees from this service; `pid` restricts /proc to the per-pid
# directories the process needs for its own introspection.
ProtectProc=invisible
ProcSubset=pid

# Native ABI only. Blocks compat-mode syscalls on x86_64 (the i386 ABI
# was historically a way to bypass syscall filters set in 64-bit terms).
SystemCallArchitectures=native

# Belt-and-braces with the in-process umask we set in
# `daemon_socket::tighten_umask_for_socket()` before bind(2). Setting it
# at the unit level too means any file created by the daemon (even via a
# future code path that forgets the explicit umask call) lands at 0o600.
UMask=0077

# Capability bounding. Caps the daemon could ever raise, even though it
# starts as root. Required:
#   CAP_IPC_LOCK   — mlockall (src/daemon.rs lock_memory)
#   CAP_CHOWN      — chown(socket, root:kepr) in src/daemon_socket.rs
#   CAP_DAC_READ_SEARCH — kept for the post-AEAD migration when User= is
#                  flipped to a non-root account that still needs to read
#                  /etc/credstore.encrypted/. Inert under User=root.
# AmbientCapabilities is empty so child processes (currently
# /usr/bin/systemd-creds) cannot escalate beyond the bounded set.
CapabilityBoundingSet=CAP_IPC_LOCK CAP_CHOWN CAP_DAC_READ_SEARCH
AmbientCapabilities=

# Syscall filter. @system-service is systemd's recommended baseline for
# long-running services and includes the resource calls (mlockall, mmap)
# the daemon needs. The deny list strips classes the daemon never uses.
# Note: do NOT add ~@resources here — that would block mlockall.
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @cpu-emulation @debug @raw-io @clock @module @obsolete
SystemCallErrorNumber=EPERM

# Daemon only opens AF_UNIX sockets (its listening socket and the journald
# socket). AF_NETLINK retained for libc internals (e.g. NSS group lookups,
# uname). All other families denied.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
