# kepr direnv integration helper (.envrc)
#
# Usage in your project's .envrc:
#   source_env completions/kepr.envrc
#   use_kepr OPENAI_API_KEY ANTHROPIC_API_KEY DB_PASS
#
use_kepr() {
  # This file is `source`d into the caller's direnv/.envrc shell (see the
  # header above) — deliberately no `set -e`/`set -u` here, since that
  # would change error-handling behaviour for the REST of the caller's
  # .envrc after this point, not just this function.
  local out
  if [[ $# -eq 0 ]]; then
    out=$(kepr env) || { echo "use_kepr: 'kepr env' failed" >&2; return 1; }
  else
    local csv
    csv=$(IFS=,; echo "$*")
    out=$(kepr env --env "$csv") || {
      echo "use_kepr: 'kepr env --env $csv' failed" >&2
      return 1
    }
  fi
  eval "$out"
}
