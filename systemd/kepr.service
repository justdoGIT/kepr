[Unit]
Description=kepr — credential manager daemon
Documentation=man:kepr(1)
After=local-fs.target
Before=network.target

# Rate-limit restarts. These keys belong in [Unit], not [Service].
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root

# Create /run/kepr (0755 root:root) before the process starts.
# Without this, ReadWritePaths below would fail at namespace-setup
# time because the path doesn't yet exist.
RuntimeDirectory=kepr
RuntimeDirectoryMode=0755

ExecStart=/usr/local/sbin/kepr-daemon

# Neutral identifier — never expose internal tool names in the
# service description or the journal tag.
SyslogIdentifier=kepr-daemon

# Restart on failure — credentials must always be available.
Restart=on-failure
RestartSec=2

# ── Hardening ────────────────────────────────────────────────────
# NoNewPrivileges must stay off: the credential backend needs the
# privilege to derive host-bound keys.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
# The credential backend persists a host-derived key under
# /var/lib/systemd/ on first use; without it in ReadWritePaths,
# ProtectSystem=strict rejects the write and `set` fails with
# "Read-only file system" until the key is manually seeded.
ReadWritePaths=/run/kepr /etc/credstore.encrypted /var/lib/systemd
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Capability bounding. Caps the daemon could ever raise, even though it
# starts as root. Required:
#   CAP_IPC_LOCK   — mlockall (src/daemon.rs lock_memory)
#   CAP_CHOWN      — chown(socket, root:kepr) in src/daemon_socket.rs
#   CAP_DAC_READ_SEARCH — kept for the post-AEAD migration when User= is
#                  flipped to a non-root account that still needs to read
#                  /etc/credstore.encrypted/. Inert under User=root.
# AmbientCapabilities is empty so child processes (currently
# /usr/bin/systemd-creds) cannot escalate beyond the bounded set.
CapabilityBoundingSet=CAP_IPC_LOCK CAP_CHOWN CAP_DAC_READ_SEARCH
AmbientCapabilities=

# Syscall filter. @system-service is systemd's recommended baseline for
# long-running services and includes the resource calls (mlockall, mmap)
# the daemon needs. The deny list strips classes the daemon never uses.
# Note: do NOT add ~@resources here — that would block mlockall.
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @cpu-emulation @debug @raw-io @clock @module @obsolete
SystemCallErrorNumber=EPERM

# Daemon only opens AF_UNIX sockets (its listening socket and the journald
# socket). AF_NETLINK retained for libc internals (e.g. NSS group lookups,
# uname). All other families denied.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
