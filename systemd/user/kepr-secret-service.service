# kepr-secret-service.service — kepr as this session's Secret Service
# (org.freedesktop.secrets), started by the session bus when a program first
# asks for it. `kepr secret-service takeover` writes the bus service file
# that names this unit (SystemdService=) and masks GNOME Keyring's units;
# `kepr secret-service restore` removes it again. Nothing here starts it at
# login on its own, and nothing is installed system-wide that would compete
# with GNOME Keyring's own bus file.
#
# The unlock dialog (pinentry, zenity or kdialog) needs the session's
# DISPLAY / WAYLAND_DISPLAY, which the desktop session imports into the user
# manager (dbus-update-activation-environment --systemd); no PrivateTmp, so
# X11 sockets stay reachable.
#
# systemctl --user reload kepr-secret-service.service re-reads
# ~/.config/kepr/secret-service.toml (the per-program policy).

[Unit]
Description=kepr: Secret Service (org.freedesktop.secrets) backed by the kepr store
Documentation=https://github.com/justdogit/kepr
After=kepr-daemon.service
Wants=kepr-daemon.service

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/local/bin/kepr secret-service run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
LimitCORE=0
UMask=0077
